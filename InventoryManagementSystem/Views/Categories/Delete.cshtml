@model InventoryManagementSystem.Models.ViewModels.CategoryViewModel

@{
    ViewData["Title"] = "Delete Category";
}

<h3>Delete Category</h3>

<div class="alert alert-warning">
    Are you sure you want to delete this category?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Description ?? "—")</dd>

            <dt class="col-sm-3">Product Count</dt>
            <dd class="col-sm-9">
                @Model.ProductCount
                @if (Model.ProductCount > 0)
                {
                    <span class="text-danger small">(Cannot delete — has products)</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>