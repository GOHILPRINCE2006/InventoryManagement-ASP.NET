@model List<InventoryManagementSystem.Models.ViewModels.CategoryViewModel>

@{
    ViewData["Title"] = "Categories";
    var canManage = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Categories</h3>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">+ Add Category</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <p class="text-muted text-center p-4 mb-0">No categories yet.</p>
        }
        else
        {
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Products</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td>@cat.Name</td>
                            <td>@(cat.Description ?? "—")</td>
                            <td>@cat.ProductCount</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                @if (canManage)
                                {
                                    <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>