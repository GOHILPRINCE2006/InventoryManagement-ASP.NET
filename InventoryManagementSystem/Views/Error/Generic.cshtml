@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="container text-center mt-5">
    <div class="py-5">
        <h1 class="display-1 text-danger">@ViewBag.Code</h1>
        <h3 class="mb-3">An Error Occurred</h3>
        <p class="text-muted">Something went wrong with your request.</p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                Go to Dashboard
            </a>
            <a href="javascript:history.back()" class="btn btn-secondary">
                Go Back
            </a>
        </div>
    </div>
</div>