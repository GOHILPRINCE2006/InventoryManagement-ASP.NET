@{
    ViewData["Title"] = "Server Error";
    Layout = "_Layout";
}

<div class="container text-center mt-5">
    <div class="py-5">
        <h1 class="display-1 text-danger">500</h1>
        <h3 class="mb-3">Something Went Wrong</h3>
        <p class="text-muted">An unexpected error occurred while processing your request.</p>
        <p class="text-muted small">Please try again. If the problem persists, contact the administrator.</p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                Go to Dashboard
            </a>
            <a href="javascript:history.back()" class="btn btn-secondary">
                Go Back
            </a>
        </div>
    </div>
</div>