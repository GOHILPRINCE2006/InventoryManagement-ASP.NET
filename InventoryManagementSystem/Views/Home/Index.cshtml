@model InventoryManagementSystem.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <h3>Welcome, @User.Identity.Name 👋</h3>
    <p class="text-muted">
        Role:
        @if (User.IsInRole("Admin"))
        {
            <span class="badge bg-danger">Admin</span>
        }
        else if (User.IsInRole("Manager"))
        {

            <span class="badge bg-warning text-dark">Manager</span>
        }
        else
        {

            <span class="badge bg-info">Employee</span>
        }
    </p>

    <div class="card mb-3 border-primary">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="mb-1">🏪 @ViewBag.ShopName</h5>
                    <small class="text-muted">Your shop</small>
                </div>
                @if (ViewBag.IsAdmin == true)
                {
                    <div class="col-md-6 text-md-end">
                        <div class="text-muted small mb-1">
                            <strong>🔑 Shop Code</strong> — Share with your employees
                        </div>
                        <div class="input-group justify-content-md-end" style="max-width: 300px; margin-left: auto;">
                            <input type="text" id="shopCodeInput" class="form-control form-control-lg fw-bold text-center"
                                   value="@ViewBag.ShopCode" readonly />
                            <button class="btn btn-primary" onclick="copyShopCode()" type="button">
                                📋 Copy
                            </button>
                        </div>
                        <small class="text-muted d-block mt-1" id="copyStatus"></small>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        function copyShopCode() {
            const input = document.getElementById('shopCodeInput');
            input.select();
            input.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(input.value);
            document.getElementById('copyStatus').innerText = '✅ Copied to clipboard!';
            setTimeout(() => {
                document.getElementById('copyStatus').innerText = '';
            }, 2000);
        }
    </script>

    <!-- Summary Cards -->
    <div class="row mb-3">
        <div class="col-md-3 mb-3">
            <div class="card border-primary">
                <div class="card-body">
                    <h6 class="text-muted">Products</h6>
                    <h2 class="mb-0">@Model.TotalProducts</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-info">
                <div class="card-body">
                    <h6 class="text-muted">Customers</h6>
                    <h2 class="mb-0">@Model.TotalCustomers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-success">
                <div class="card-body">
                    <h6 class="text-muted">Sales</h6>
                    <h2 class="mb-0">@Model.TotalSales</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-warning">
                <div class="card-body">
                    <h6 class="text-muted">Low Stock</h6>
                    <h2 class="mb-0">@Model.LowStockCount</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Financial Row -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted">Total Revenue</h6>
                    <h3 class="text-success mb-0">₹@Model.TotalRevenue.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted">Total Purchase Cost</h6>
                    <h3 class="text-danger mb-0">₹@Model.TotalPurchaseCost.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted">Estimated Profit</h6>
                    <h3 class="@(Model.EstimatedProfit >= 0 ? "text-success" : "text-danger") mb-0">
                        ₹@Model.EstimatedProfit.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Low Stock Items -->
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header d-flex justify-content-between">
                    <span>⚠️ Low Stock Products</span>
                    <a asp-controller="Stock" asp-action="LowStock" class="small">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.LowStockItems.Count == 0)
                    {
                        <p class="text-muted p-3 mb-0">All products have sufficient stock. ✅</p>
                    }
                    else
                    {
                        <table class="table mb-0">
                            <thead>
                                <tr><th>Product</th><th>In Stock</th><th>Min</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.LowStockItems)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>
                                            <span class="@(item.Quantity == 0 ? "badge bg-danger" : "badge bg-warning text-dark")">
                                                @item.Quantity
                                            </span>
                                        </td>
                                        <td>@item.MinStockLevel</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Sales -->
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header d-flex justify-content-between">
                    <span>🧾 Recent Sales</span>
                    <a asp-controller="Sales" asp-action="Index" class="small">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentSales.Count == 0)
                    {
                        <p class="text-muted p-3 mb-0">No sales yet.</p>
                    }
                    else
                    {
                        <table class="table mb-0">
                            <thead>
                                <tr><th>Invoice</th><th>Customer</th><th>Total</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.RecentSales)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Sales" asp-action="Details" asp-route-id="@s.SaleId">
                                                @s.InvoiceNumber
                                            </a>
                                        </td>
                                        <td>@s.CustomerName</td>
                                        <td>₹@s.TotalAmount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center mt-5">
        <h1>Inventory Management System</h1>
        <p class="lead text-muted">Manage products, suppliers, customers, purchases, and sales — all in one place.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary me-2">Login</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary">Register</a>
    </div>
}