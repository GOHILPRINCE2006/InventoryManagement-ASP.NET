@model InventoryManagementSystem.Models.Entities.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h3>Delete Product</h3>

<div class="alert alert-warning">
    Are you sure you want to delete this product? (Soft delete — it will be hidden from lists.)
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">SKU</dt>
            <dd class="col-sm-9">@Model.SKU</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category.Name</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">₹@Model.Price.ToString("N2")</dd>

            <dt class="col-sm-3">Quantity</dt>
            <dd class="col-sm-9">@Model.Quantity</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>