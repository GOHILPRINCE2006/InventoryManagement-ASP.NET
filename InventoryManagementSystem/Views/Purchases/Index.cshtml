@model List<InventoryManagementSystem.Models.Entities.Purchase>

@{
    ViewData["Title"] = "Purchases";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Purchase Orders</h3>
    <a asp-action="Create" class="btn btn-primary">+ New Purchase</a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <p class="text-muted text-center p-4 mb-0">No purchases yet.</p>
        }
        else
        {
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Number</th>
                        <th>Date</th>
                        <th>Supplier</th>
                        <th>Created By</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.PurchaseNumber</td>
                            <td>@p.PurchaseDate.ToString("dd-MMM-yyyy")</td>
                            <td>@p.Supplier.Name</td>
                            <td>@p.User.Email</td>
                            <td>@p.PurchaseItems.Count</td>
                            <td>₹@p.TotalAmount.ToString("N2")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>