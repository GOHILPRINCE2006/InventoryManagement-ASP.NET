@{
    ViewData["Title"] = "Reports";
}

<h3>Reports</h3>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>📊 Sales Report</h5>
                <p class="text-muted">View sales by date range and customer.</p>
                <a asp-action="Sales" class="btn btn-primary">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>📦 Inventory Report</h5>
                <p class="text-muted">View stock levels and stock value by category.</p>
                <a asp-action="Inventory" class="btn btn-primary">Open</a>
            </div>
        </div>
    </div>
</div>