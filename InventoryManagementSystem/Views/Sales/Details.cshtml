@model InventoryManagementSystem.Models.Entities.Sale

@{
    ViewData["Title"] = "Invoice";
}

<!-- Screen version (with app layout) -->
<div class="screen-view">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Invoice @Model.InvoiceNumber</h3>
        <div>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            <button onclick="window.print()" class="btn btn-primary">🖨️ Print Invoice</button>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5>Invoice Details</h5>
                    <p class="mb-1"><strong>Invoice #:</strong> @Model.InvoiceNumber</p>
                    <p class="mb-1"><strong>Date:</strong> @Model.SaleDate.ToString("dd-MMM-yyyy")</p>
                    <p class="mb-1"><strong>Sold By:</strong> @Model.User.Email</p>
                </div>
                <div class="col-md-6">
                    <h5>Customer</h5>
                    <p class="mb-1"><strong>Name:</strong> @Model.Customer.Name</p>
                    <p class="mb-1"><strong>Phone:</strong> @(Model.Customer.Phone ?? "—")</p>
                    <p class="mb-1"><strong>Email:</strong> @(Model.Customer.Email ?? "—")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.SaleItems)
                    {
                        <tr>
                            <td>@item.Product.Name</td>
                            <td class="text-end">@item.Quantity</td>
                            <td class="text-end">₹@item.UnitPrice.ToString("N2")</td>
                            <td class="text-end">₹@item.SubTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @if (Model.Discount > 0)
                    {
                        <tr>
                            <th colspan="3" class="text-end">Discount:</th>
                            <th class="text-end">-₹@Model.Discount.ToString("N2")</th>
                        </tr>
                    }
                    <tr>
                        <th colspan="3" class="text-end">Total:</th>
                        <th class="text-end">₹@Model.TotalAmount.ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- Print version (clean, no layout) — hidden on screen -->
<div class="print-view">
    <div style="max-width: 800px; margin: 0 auto; padding: 20px; font-family: Arial, sans-serif;">

        <!-- Header -->
        <!-- Header -->
        <div style="text-align: center; margin-bottom: 30px; border-bottom: 2px solid #333; padding-bottom: 15px;">
            <h1 style="margin: 0;">INVOICE</h1>
        </div>

        <!-- Invoice + Customer Info -->
        <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
            <div>
                <h3 style="margin-bottom: 10px;">INVOICE</h3>
                <p><strong>Invoice #:</strong> @Model.InvoiceNumber</p>
                <p><strong>Date:</strong> @Model.SaleDate.ToString("dd-MMM-yyyy")</p>
                <p><strong>Sold By:</strong> @Model.User.Email</p>
            </div>
            <div style="text-align: right;">
                <h4 style="margin-bottom: 10px;">Bill To:</h4>
                <p><strong>@Model.Customer.Name</strong></p>
                @if (!string.IsNullOrEmpty(Model.Customer.Phone))
                {
                    <p>@Model.Customer.Phone</p>
                }
                @if (!string.IsNullOrEmpty(Model.Customer.Email))
                {
                    <p>@Model.Customer.Email</p>
                }
                @if (!string.IsNullOrEmpty(Model.Customer.Address))
                {
                    <p>@Model.Customer.Address</p>
                }
            </div>
        </div>

        <!-- Items Table -->
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
            <thead>
                <tr style="background: #333; color: white;">
                    <th style="padding: 10px; text-align: left; border: 1px solid #333;">#</th>
                    <th style="padding: 10px; text-align: left; border: 1px solid #333;">Product</th>
                    <th style="padding: 10px; text-align: right; border: 1px solid #333;">Qty</th>
                    <th style="padding: 10px; text-align: right; border: 1px solid #333;">Unit Price</th>
                    <th style="padding: 10px; text-align: right; border: 1px solid #333;">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var rowNum = 1;
                }
                @foreach (var item in Model.SaleItems)
                {
                    <tr>
                        <td style="padding: 10px; border: 1px solid #ddd;">@rowNum</td>
                        <td style="padding: 10px; border: 1px solid #ddd;">@item.Product.Name</td>
                        <td style="padding: 10px; border: 1px solid #ddd; text-align: right;">@item.Quantity</td>
                        <td style="padding: 10px; border: 1px solid #ddd; text-align: right;">₹@item.UnitPrice.ToString("N2")</td>
                        <td style="padding: 10px; border: 1px solid #ddd; text-align: right;">₹@item.SubTotal.ToString("N2")</td>
                    </tr>
                    rowNum++;
                }
            </tbody>
        </table>

        <!-- Totals -->
        <div style="text-align: right; margin-bottom: 30px;">
            <p style="margin: 5px 0;"><strong>Subtotal:</strong> ₹@((Model.TotalAmount + Model.Discount).ToString("N2"))</p>
            @if (Model.Discount > 0)
            {
                <p style="margin: 5px 0; color: #d9534f;"><strong>Discount:</strong> -₹@Model.Discount.ToString("N2")</p>
            }
            <p style="margin: 10px 0; font-size: 18px; border-top: 2px solid #333; padding-top: 10px;">
                <strong>Grand Total: ₹@Model.TotalAmount.ToString("N2")</strong>
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div style="margin-bottom: 30px; padding: 10px; background: #f9f9f9; border-left: 3px solid #333;">
                <strong>Notes:</strong> @Model.Notes
            </div>
        }

        <!-- Footer -->
        <div style="text-align: center; margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd; color: #666; font-size: 12px;">
            <p>Thank you for your business!</p>
            <p>This is a computer-generated invoice.</p>
        </div>
    </div>
</div>

<style>
    /* Hide print view on screen */
    .print-view {
        display: none;
    }

    /* When printing */
    @@media print {
        /* Hide everything */
        .screen-view,
        .navbar,
        nav,
        .sidebar,
        .col-md-2,
        .sidebar-brand,
        .sidebar-nav,
        .sidebar-footer,
        footer,
        button,
        .btn {
            display: none !important;
        }

        /* Show print view */
        .print-view {
            display: block !important;
        }

        /* Reset main content margins */
        .container-fluid {
            padding: 0 !important;
            margin: 0 !important;
        }

        .row {
            margin: 0 !important;
        }

        .col-md-10, .col-12 {
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        body {
            background: white !important;
            font-size: 12px;
        }
    }
</style>