@model InventoryManagementSystem.Models.Entities.Sale

@{
    ViewData["Title"] = "Invoice";
}

<h3>Invoice @Model.InvoiceNumber</h3>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Invoice</dt>
            <dd class="col-sm-9">@Model.InvoiceNumber</dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.SaleDate.ToString("dd-MMM-yyyy")</dd>

            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">@Model.Customer.Name</dd>

            <dt class="col-sm-3">Sold By</dt>
            <dd class="col-sm-9">@Model.User.Email</dd>

            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@(Model.Notes ?? "—")</dd>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">Items</div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.SaleItems)
                {
                    <tr>
                        <td>@item.Product.Name</td>
                        <td>@item.Quantity</td>
                        <td>₹@item.UnitPrice.ToString("N2")</td>
                        <td>₹@item.SubTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @if (Model.Discount > 0)
                {
                    <tr>
                        <th colspan="3" class="text-end">Discount:</th>
                        <th>-₹@Model.Discount.ToString("N2")</th>
                    </tr>
                }
                <tr>
                    <th colspan="3" class="text-end">Total:</th>
                    <th>₹@Model.TotalAmount.ToString("N2")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    <button onclick="window.print()" class="btn btn-outline-primary">Print</button>
</div>