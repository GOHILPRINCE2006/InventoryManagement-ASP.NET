@model List<InventoryManagementSystem.Models.Entities.Sale>

@{
    ViewData["Title"] = "Sales";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Sales / Invoices</h3>
    <a asp-action="Create" class="btn btn-primary">+ New Sale</a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <p class="text-muted text-center p-4 mb-0">No sales yet.</p>
        }
        else
        {
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Sold By</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.InvoiceNumber</td>
                            <td>@s.SaleDate.ToString("dd-MMM-yyyy")</td>
                            <td>@s.Customer.Name</td>
                            <td>@s.User.Email</td>
                            <td>@s.SaleItems.Count</td>
                            <td>₹@s.TotalAmount.ToString("N2")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>