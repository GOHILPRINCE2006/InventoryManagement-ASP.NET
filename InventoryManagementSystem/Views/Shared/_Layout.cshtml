<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- Top Navbar -->
    <nav class="navbar navbar-dark bg-dark px-3">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            Inventory System
        </a>

        <div class="ms-auto">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <span class="text-white me-3">Hello, @User.Identity.Name</span>

                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm me-2">Login</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-sm">Register</a>
            }
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <!-- Sidebar -->
                <div class="col-md-2 bg-light border-end min-vh-100 p-3">
                    <partial name="_Sidebar" />
                </div>

                <!-- Main Content -->
                <div class="col-md-10 p-4">
                    @RenderBody()
                </div>
            }
            else
            {
                <!-- Public pages: full width -->
                <div class="col-12 p-4">
                    @RenderBody()
                </div>
            }

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>