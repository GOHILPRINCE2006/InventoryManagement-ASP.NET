@model InventoryManagementSystem.Models.ViewModels.SupplierViewModel

@{
    ViewData["Title"] = "Delete Supplier";
}

<h3>Delete Supplier</h3>

<div class="alert alert-warning">
    Are you sure you want to delete this supplier?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Contact Person</dt>
            <dd class="col-sm-9">@(Model.ContactPerson ?? "—")</dd>

            <dt class="col-sm-3">Products</dt>
            <dd class="col-sm-9">
                @Model.ProductCount
                @if (Model.ProductCount > 0)
                {
                    <span class="text-danger small">(Cannot delete — has products)</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>