@model List<InventoryManagementSystem.Models.ViewModels.SupplierViewModel>

@{
    ViewData["Title"] = "Suppliers";
    var canManage = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Suppliers</h3>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">+ Add Supplier</a>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <p class="text-muted text-center p-4 mb-0">No suppliers yet.</p>
        }
        else
        {
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Contact Person</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Products</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.Name</td>
                            <td>@(s.ContactPerson ?? "—")</td>
                            <td>@(s.Phone ?? "—")</td>
                            <td>@(s.Email ?? "—")</td>
                            <td>@s.ProductCount</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                @if (canManage)
                                {
                                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>